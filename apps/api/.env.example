# PostgreSQL connection for SkillBridge API
DATABASE_URL="postgresql://skillbridge:skillbridge_dev@localhost:5432/skillbridge?schema=public"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="*"

# JWT (CHANGE THESE IN PRODUCTION)
JWT_SECRET="dev-secret-change-me-in-prod-7f3a9c2e"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-2b8d4f1a"
JWT_REFRESH_EXPIRES_IN="30d"

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Supabase private certificate storage
SUPABASE_URL="https://hkbacfvanogrnqlegbae.supabase.co"
