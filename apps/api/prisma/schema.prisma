// Prisma schema for SkillBridge
// Mirrors the domain model in @skillbridge/types, made relational for scale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  employer
  admin
  factory
  worker
}

enum ProjectStatus {
  draft
  open
  paused
  completed
  cancelled
  expired
}

enum ProjectType {
  internship
  part_time
  freelance
  full_time
}

enum ApplicationStatus {
  pending
  reviewing
  shortlisted
  accepted
  hired
  rejected
  withdrawn
}

enum ApplicationEventType {
  application_submitted
  application_reviewed
  candidate_shortlisted
  application_accepted
  candidate_hired
  application_rejected
  application_withdrawn
}

enum CertificateVerificationStatus {
  pending
  verified
  rejected
}

enum NotificationType {
  application_status_changed
  certificate_verified
  certificate_rejected
  verification_requested
  report_status_changed
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  passwordHash  String?
  phone         String?  @unique
  role          UserRole
  name          String   @default("")
  avatar        String?
  emailVerified Boolean  @default(false)
  suspended     Boolean   @default(false)
  onboardingStep Int     @default(0)
  onboardingCompletedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student   Student?
  employer  Employer?
  factory   Factory?
  worker    Worker?
  workerProfile WorkerProfile?
  applicationStatusHistory ApplicationStatusHistory[]
  certificateVerificationHistory CertificateVerificationHistory[]
  notifications Notification[]

  @@index([role])
}

model Student {
  id            String   @id @default(cuid())
  userId        String   @unique
  university    String?
  major         String?
  graduationYear Int?
  skills        String[]
  location      String?
  opportunityTypes ProjectType[] @default([])
  workPreference String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioItems   PortfolioItem[]
  workExperiences  WorkExperience[]
  applications     Application[]
  aiResumes        AIResume[]
  careerRecs       CareerRecommendation[]
  certificates     Certificate[]   // <-- NEW

  @@index([university])
}

model Employer {
  id          String    @id @default(cuid())
  userId      String    @unique
  companyName String
  position    String?
  industry    String?
  companySize Int       @default(0)
  website     String?
  location    String?
  hiringTypes ProjectType[] @default([])
  hiringSkills String[]  @default([])
  workPreference String?
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]
  workExperiences WorkExperience[]
  teamMembers   TeamMember[]

  @@index([verified])
}

model TeamMember {
  id         String   @id @default(cuid())
  employerId String
  name       String
  email      String
  role       String   @default("recruiter") // recruiter | hiring_manager | admin
  status     String   @default("invited")   // invited | active
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@unique([employerId, email])
}

model Factory {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  location  String?
  capacity  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Worker {
  id        String   @id @default(cuid())
  userId    String   @unique
  skills    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String       @id @default(cuid())
  title          String
  description    String
  employerId     String
  type           ProjectType
  status         ProjectStatus @default(open)
  budget         Float?
  startDate      DateTime?
  endDate        DateTime?
  skillsRequired String[]
  location       String?
  remote         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employer        Employer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications    Application[]
  workExperiences WorkExperience[]

  @@index([employerId])
  @@index([status])
  @@index([type])
}

model Application {
  id             String           @id @default(cuid())
  projectId      String
  studentId      String
  status         ApplicationStatus @default(pending)
  reviewNote     String?
  candidateFeedback String?
  coverLetter    String?
  proposedBudget Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  statusHistory ApplicationStatusHistory[]
  events        ApplicationEvent[]
  notifications Notification[]

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
  @@index([status])
}

// These workflow records already exist in the applied hiring-workflow
// migration. Keep them in the Prisma schema so lifecycle writes are typed and
// generated client access matches the database.
model ApplicationStatusHistory {
  id                String            @id @default(cuid())
  applicationId     String
  previousStatus    ApplicationStatus
  newStatus         ApplicationStatus
  actorId           String?
  reviewNote        String?
  candidateFeedback String?
  createdAt         DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorId])
}

model ApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  eventType     ApplicationEventType
  actorId       String?
  createdAt     DateTime             @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([eventType, createdAt])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  applicationId String?
  type          NotificationType
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([applicationId])
}

model Certificate {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?
  fileUrl     String
  fileKey     String   // path/key for storage backend
  mimeType    String
  fileSize    Int      // bytes
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  // Explicit verification lifecycle state. Prefer this over `verified` for
  // product logic; `verified` is retained for backward compatibility.
  verificationStatus CertificateVerificationStatus @default(pending)
  // Internal admin note — MUST NOT be returned to students or employers.
  verificationNote String?
  // Candidate-facing rejection reason — returned to the student on rejection.
  rejectionReason  String?
  // Reviewer audit trail.
  verifiedBy String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  history CertificateVerificationHistory[]

  @@index([studentId])
  @@index([verified])
  @@index([verificationStatus])
}

// Immutable audit trail for every admin certificate verification decision.
// Writes happen only inside the admin decision flow; existing rows are never
// updated or deleted so reviewers cannot rewrite history.
model CertificateVerificationHistory {
  id             String                      @id @default(cuid())
  certificateId  String
  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  previousStatus CertificateVerificationStatus
  newStatus      CertificateVerificationStatus
  candidateReason String?
  internalNote   String?
  createdAt      DateTime @default(now())

  @@index([certificateId, createdAt])
  @@index([actorId])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?
  imageUrl    String?
  projectUrl  String?
  technologies String[]
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model WorkExperience {
  id          String   @id @default(cuid())
  studentId   String
  projectId   String?
  employerId  String?
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  rating      Int?
  createdAt   DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employer Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([verified])
}

model AIResume {
  id        String   @id @default(cuid())
  studentId String
  content   String
  template  String   @default("modern")
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model CareerRecommendation {
  id                 String   @id @default(cuid())
  studentId          String
  recommendedProjectIds String[]
  recommendedSkills  String[]
  createdAt          DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ===========================================================================
// WORKER VERTICAL SLICE
// Domain for the Cambodia-first blue-collar worker app (SkillBridge Worker).
// Kept separate from the Student/Certificate model so the two products can
// coexist in one database without coupling. Coarse verificationLevel enum
// drives the trust UI; actual verification is a later operational workflow.
// ===========================================================================

enum VerificationLevel {
  none
  job_checked
  company_checked
  identity_checked
}

enum ShiftType {
  day
  night
  rotating
  flexible
}

enum EmploymentType {
  full_time
  contract
  seasonal
}

enum WorkerApplicationStatus {
  submitted
  reviewing
  shortlisted
  interview
  hired
  rejected
  withdrawn
}

model Company {
  id          String           @id @default(cuid())
  name        String
  location    String?
  verified    Boolean          @default(false)
  verificationLevel VerificationLevel @default(none)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  jobs Job[]

  @@index([verified])
}

model Job {
  id               String           @id @default(cuid())
  companyId        String
  title            String
  summary          String?
  payPerMonth      Int
  currency         String           @default("USD")
  shift            ShiftType       @default(day)
  employmentType   EmploymentType  @default(full_time)
  location         String?
  distanceKm       Int              @default(0)
  skillsRequired   String[]         @default([])
  matchReason      String?
  // Worker-facing job conditions (real, verified where possible).
  accommodation    Boolean          @default(false)
  transportProvided Boolean         @default(false)
  overtimePaid     Boolean          @default(false)
  verificationLevel VerificationLevel @default(none)
  lastCheckedDate  DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications WorkerApplication[]

  @@index([companyId])
  @@index([verificationLevel])
}

model WorkerProfile {
  id              String   @id @default(cuid())
  userId          String?  @unique
  phone           String   @unique
  fullName        String?
  preferredArea   String?
  availability    String?
  skills          String[] @default([])
  languages       String[] @default([])
  identityVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  applications WorkerApplication[]
  workRecords WorkRecord[]
  passportShares PassportShare[]
  reports Report[]
  blocks Block[]

  @@index([phone])
  @@index([userId])
}

model WorkerApplication {
  id          String                 @id @default(cuid())
  workerId    String
  jobId       String
  status      WorkerApplicationStatus @default(submitted)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([workerId, jobId])
  @@index([workerId])
  @@index([jobId])
  @@index([status])
}

// Career Passport work record — company-verified past employment.
model WorkRecord {
  id          String   @id @default(cuid())
  workerId    String
  role        String
  company     String
  workplace   String?
  startDate   DateTime
  endDate     DateTime?
  verified    Boolean  @default(false)
  provenance  String?  // e.g. "company_verified" | "self_declared"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([verified])
}

// Phone OTP for phone-first worker sign-in (blueprint §12: phone OTP is the
// default worker path; email is optional recovery, not first access).
// Codes are stored hashed, expire quickly, and are consumed/attempt-limited.
model PhoneOtp {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  verifiedAt DateTime?

  @@index([phone, createdAt])
  @@index([phone, expiresAt])
}

// Career Passport sharing (blueprint §5): expiring, revocable links so workers
// control what employers see. The public view exposes only shared fields —
// never phone, documents, or government identifiers.
model PassportShare {
  id        String    @id @default(cuid())
  workerId  String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([token])
}

// Worker safety reporting (blueprint §4, §7): reports are worker-scoped,
// never shown to the recruiter, and carry a worker-facing support status.
enum ReportCategory {
  payment_requested
  false_information
  recruiter_identity
  unsafe_contact
  other
}

enum ReportStatus {
  submitted
  under_review
  resolved
}

model Report {
  id          String         @id @default(cuid())
  workerId    String
  category    ReportCategory
  description String
  evidence    String?
  status      ReportStatus   @default(submitted)
  adminNote   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([status])
}

// Worker-initiated blocks: a blocked job is hidden from the worker's feed
// (blueprint: "In-app report and block").
model Block {
  id        String   @id @default(cuid())
  workerId  String
  jobId     String
  createdAt DateTime @default(now())

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, jobId])
  @@index([workerId])
}
