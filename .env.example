# SkillBridge — environment variables (copy to .env.local / .env and fill in)
# NEVER commit the real values. .env*.local is git-ignored.

# ---- Supabase (web auth + storage + DB) ----
# Anon key is safe to expose to the browser (RLS limits what it can do).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role KEY BYPASSES RLS — server-side only, NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Express API (apps/api) ----
# JWT secrets — generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# The API's own DB connection (Postgres 16).
DATABASE_URL=postgresql://user:password@host:5432/skillbridge
# Base URL the web app calls. In dev: http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ---- Backup (scripts/db-backup.sh) ----
# Optional: bucket name to copy dumps into Supabase Storage.
# BACKUP_BUCKET=skillbridge-backups
