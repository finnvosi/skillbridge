# API Configuration
# In dev, the Next.js app proxies /api/v1 to the Express backend via rewrites.
# The web app does NOT verify JWTs client-side — all auth happens on the Express API.
# NEXT_PUBLIC_API_URL must match what next.config.ts expects for the rewrite.
NEXT_PUBLIC_API_URL=http://localhost:3000

# JWT secrets — shared with the Express API for consistency.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Leave empty for dev; the API generates an ephemeral random secret per process.
# In production, BOTH env vars MUST be set.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Public Supabase client used only for signed certificate uploads.
NEXT_PUBLIC_SUPABASE_URL=https://hkbacfvanogrnqlegbae.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_CERTIFICATES_BUCKET=certificates
